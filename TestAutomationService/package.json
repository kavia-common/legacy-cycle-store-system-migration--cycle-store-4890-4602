{
    "name": "test-automation-service",
    "version": "1.0.0",
    "description": "Test Automation Service with orchestration, Selenium integration, CI/CD endpoints, and reporting",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon src/server.js",
        "test": "jest",
        "lint": "eslint .",
        "openapi": "node generate_openapi.js"
    },
    "dependencies": {
        "axios": "^1.12.2",
        "bcryptjs": "^3.0.2",
        "cors": "2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "jsonwebtoken": "^9.0.2",
        "multer": "^2.0.2",
        "node-fetch": "^2.7.0",
        "passport": "^0.7.0",
        "passport-oauth2": "^1.8.0",
        "selenium-webdriver": "^4.33.0",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^13.0.0",
        "winston": "^3.17.0",
        "ws": "^8.18.3"
    },
    "devDependencies": {
        "eslint": "^9.24.0",
        "globals": "^16.0.0",
        "jest": "^29.7.0",
        "nodemon": "^3.0.1",
        "supertest": "^7.1.4"
    },
    "nodemonConfig": {
        "watch": [
            "src"
        ],
        "ignore": [
            "node_modules",
            "package.json",
            "package-lock.json",
            "post_process_status.lock",
            "*.lock",
            "*.log",
            "*.md",
            ".git",
            "dist",
            "build",
            "interfaces"
        ],
        "ext": "js,json"
    }
}
