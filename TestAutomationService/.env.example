# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Storage and outputs
STORAGE_DIR=./storage
RESULTS_DIR=./storage/results
REPORTS_DIR=./storage/reports

# Execution configuration
# Preferred executor commands (set one of these to enable real test runs)
# Example: npx playwright test --reporter=list
PLAYWRIGHT_CMD=
# Example: npm run selenium:e2e
SELENIUM_CMD=
# Alternate executor name (e.g., jest or custom script name). If provided, service will run "npm test" for jest.
TEST_EXECUTOR=

# Optional concurrency limit (not enforced in demo implementation)
MAX_CONCURRENT_RUNS=2

# Demo webhook secret/token (if any)
WEBHOOK_SECRET=
