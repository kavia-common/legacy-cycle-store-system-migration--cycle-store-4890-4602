# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Selenium Grid Configuration
SELENIUM_GRID_URL=http://selenium-hub:4444/wd/hub
DEFAULT_TEST_TIMEOUT=30000
MAX_CONCURRENT_JOBS=3

# Authentication & Security
JWT_SECRET=your-jwt-secret-key-here
OAUTH2_CLIENT_ID=your-oauth2-client-id
OAUTH2_CLIENT_SECRET=your-oauth2-client-secret
OAUTH2_AUTH_URL=https://auth.cyclestore.com/oauth/authorize
OAUTH2_TOKEN_URL=https://auth.cyclestore.com/oauth/token

# Service Integration
NOTIFICATION_SERVICE_URL=http://notification-service:4003
MONITORING_SERVICE_URL=http://monitoring-service:4001
SERVICE_AUTH_TOKEN=your-service-auth-token

# Notification Settings
FAILURE_EMAIL_RECIPIENTS=admin@cyclestore.com,qa@cyclestore.com

# CORS Configuration
CORS_ORIGIN=*

# Database Configuration (if needed for future enhancements)
DATABASE_URL=mysql://user:password@localhost:3306/test_automation

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=/var/log/test-automation-service.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Test Results Storage
RESULTS_STORAGE_PATH=/var/test-results
SCREENSHOTS_STORAGE_PATH=/var/test-screenshots
